{
  "name": "claude-dm-campaign",
  "version": "1.0.0",
  "description": "D&D Campaign Manager with Claude AI as Dungeon Master",
  "main": "complete-intelligent-server.js",
  "scripts": {
    "start": "node complete-intelligent-server.js",
    "dev": "nodemon complete-intelligent-server.js",
    "ui:dev": "cd ui && vite",
    "ui:build": "cd ui && vite build",
    "ui:preview": "cd ui && vite preview",
